{
  "compilerOptions": {
    "types": ["node", "playwright"],
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {}
  },
  "include": [
    "playwright.config.ts",
    "e2e/tests/**/*.ts",
    "e2e/helpers/global-setup.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
